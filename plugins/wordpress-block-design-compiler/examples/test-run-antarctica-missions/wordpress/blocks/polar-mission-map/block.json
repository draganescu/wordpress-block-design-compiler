{
  "apiVersion": 3,
  "name": "wbdc/polar-mission-map",
  "title": "Polar Mission Map",
  "category": "design",
  "description": "Editable polar coordinate map for Antarctic mission nodes.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Traverse corridor"
    },
    "caption": {
      "type": "string",
      "default": "sensor line / katabatic wind model / crevasse scan"
    },
    "nodes": {
      "type": "array",
      "default": [
        { "label": "VOSTOK", "className": "node-one" },
        { "label": "ROSS", "className": "node-two" },
        { "label": "DOME C", "className": "node-three" }
      ]
    }
  },
  "supports": {
    "anchor": true,
    "align": ["wide", "full"],
    "className": true,
    "color": { "text": true, "background": true },
    "spacing": { "margin": true, "padding": true, "blockGap": true },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "html": false
  }
}
