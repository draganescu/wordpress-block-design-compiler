{
  "apiVersion": 3,
  "name": "wbdc/dam-gateway",
  "title": "Dam Gateway",
  "category": "design",
  "description": "Editorial Dutch dams gateway with telemetry panel.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "titleId": { "type": "string", "default": "gateway-title" },
    "eyebrow": { "type": "string", "default": "" },
    "titleLines": { "type": "array", "default": [] },
    "thesis": { "type": "string", "default": "" },
    "panelAriaLabel": { "type": "string", "default": "Delta mission telemetry" },
    "panelLabel": { "type": "string", "default": "" },
    "panelStatus": { "type": "string", "default": "" },
    "metrics": { "type": "array", "default": [] }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "spacing": { "margin": true, "padding": true },
    "html": false
  }
}
