{
  "apiVersion": 3,
  "name": "wbdc/dam-navigation",
  "title": "Dam Navigation",
  "category": "design",
  "description": "Semantic Dutch dams header navigation.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "ariaLabel": { "type": "string", "default": "Mission navigation" },
    "homeUrl": { "type": "string", "default": "#top" },
    "homeLabel": { "type": "string", "default": "Mastering the Water home" },
    "mark": { "type": "string", "default": "" },
    "title": { "type": "string", "default": "" },
    "navLabel": { "type": "string", "default": "Primary" },
    "links": { "type": "array", "default": [] },
    "actionText": { "type": "string", "default": "" },
    "actionUrl": { "type": "string", "default": "#archive" }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "spacing": { "margin": true, "padding": true },
    "html": false
  }
}
