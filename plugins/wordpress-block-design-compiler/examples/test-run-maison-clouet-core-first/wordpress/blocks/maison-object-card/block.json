{
  "apiVersion": 3,
  "name": "wbdc/maison-object-card",
  "title": "Maison Object Card",
  "category": "design",
  "description": "Reusable typed objet card for shop grids and journal embeds.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "title": { "type": "string", "default": "1960s opaline vase" },
    "price": { "type": "string", "default": "€120" },
    "category": { "type": "string", "default": "glass" },
    "story": { "type": "string", "default": "Found at a house clearance near Apt, still wrapped in a pharmacy calendar from 1971." },
    "photoVariant": { "type": "string", "default": "vase" },
    "layoutVariant": { "type": "string", "default": "" },
    "buttonText": { "type": "string", "default": "tell me more" },
    "style": { "type": "object", "default": {} }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "spacing": { "padding": true, "margin": true, "blockGap": true },
    "color": { "text": true, "background": true },
    "typography": { "fontSize": true, "lineHeight": true },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "dimensions": { "minHeight": true }
  }
}
