{
  "apiVersion": 3,
  "name": "wbdc/market-rsvp-form",
  "title": "Market RSVP Form",
  "category": "forms",
  "description": "Editable semantic route-card RSVP form.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "action": { "type": "string", "default": "/night-market-rsvp" },
    "method": { "type": "string", "default": "post" },
    "fields": { "type": "array", "default": [] },
    "buttonText": { "type": "string", "default": "Send route signal" }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "spacing": { "margin": true, "padding": true, "blockGap": true },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "html": false
  }
}
