{
  "apiVersion": 3,
  "name": "wbdc/stall-constellation",
  "title": "Stall Constellation",
  "category": "design",
  "description": "Editable asymmetric market stall constellation.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "ariaLabel": {
      "type": "string",
      "default": "Featured market stalls"
    },
    "stalls": {
      "type": "array",
      "default": []
    },
    "style": {
      "type": "object",
      "default": {}
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "html": false,
    "color": {
      "text": true,
      "background": true,
      "gradients": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "dimensions": {
      "minHeight": true
    }
  }
}
