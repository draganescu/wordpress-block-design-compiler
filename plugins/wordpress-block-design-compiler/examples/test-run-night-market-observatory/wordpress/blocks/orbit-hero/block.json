{
  "apiVersion": 3,
  "name": "wbdc/orbit-hero",
  "title": "Orbit Hero",
  "category": "design",
  "description": "Editorial hero with an orbit market map and live field readings.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "titleId": { "type": "string", "default": "hero-title" },
    "eyebrow": { "type": "string", "default": "" },
    "titleLines": { "type": "array", "default": [] },
    "thesis": { "type": "string", "default": "" },
    "boardAriaLabel": { "type": "string", "default": "Tonight's field readings" },
    "boardLabel": { "type": "string", "default": "Tonight's field" },
    "boardStatus": { "type": "string", "default": "" },
    "metrics": { "type": "array", "default": [] },
    "visualAriaLabel": { "type": "string", "default": "Market orbit map" },
    "nodes": { "type": "array", "default": [] }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "spacing": { "margin": true, "padding": true },
    "html": false
  }
}
