{
  "apiVersion": 3,
  "name": "wbdc/vellum-site-header",
  "title": "Vellum Site Header",
  "category": "design",
  "description": "Semantic editable header for the Vellum & Volt example.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "ariaLabel": { "type": "string", "default": "Site header" },
    "homeUrl": { "type": "string", "default": "#top" },
    "homeLabel": { "type": "string", "default": "Vellum & Volt home" },
    "mark": { "type": "string", "default": "V" },
    "title": { "type": "string", "default": "Vellum &amp; Volt" },
    "subtitle": { "type": "string", "default": "Letterpress Studio" },
    "navLabel": { "type": "string", "default": "Primary navigation" },
    "links": { "type": "array", "default": [] },
    "actionText": { "type": "string", "default": "Book a press consult" },
    "actionUrl": { "type": "string", "default": "#booking" }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "spacing": { "margin": true, "padding": true },
    "html": false
  }
}
