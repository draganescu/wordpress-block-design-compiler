{
  "apiVersion": 3,
  "name": "wbdc/press-consult-form",
  "title": "Press Consult Form",
  "category": "forms",
  "description": "Editable static booking/contact form for press consultations.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "action": {
      "type": "string",
      "default": "/contact"
    },
    "method": {
      "type": "string",
      "default": "post"
    },
    "fields": {
      "type": "array",
      "default": [
        {
          "label": "Name",
          "type": "text",
          "name": "name",
          "placeholder": "Your name",
          "required": true
        },
        {
          "label": "Email",
          "type": "email",
          "name": "email",
          "placeholder": "you@example.com",
          "required": true
        },
        {
          "label": "Project notes",
          "type": "textarea",
          "name": "message",
          "placeholder": "Wedding suite, workshop date, brand cards...",
          "required": false
        }
      ]
    },
    "buttonText": {
      "type": "string",
      "default": "Send the brief"
    }
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "className": true,
    "color": {
      "text": true,
      "background": true,
      "gradients": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "html": false
  }
}
