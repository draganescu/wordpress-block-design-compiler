{
  "apiVersion": 3,
  "name": "wbdc/vellum-proof-figure",
  "title": "Vellum Proof Figure",
  "category": "design",
  "description": "Editable decorative letterpress proof figure.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "ariaLabel": { "type": "string", "default": "Layered letterpress proof sheet illustration" },
    "kicker": { "type": "string", "default": "Proof 04" },
    "title": { "type": "string", "default": "Fern &amp; Brass" },
    "detail": { "type": "string", "default": "blind emboss / moss ink / deckled edge" },
    "dotCount": { "type": "number", "default": 3 }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "spacing": { "margin": true, "padding": true },
    "html": false
  }
}
