            "  <div class='workshop-banner'>",
            "    <p class='eyebrow'>Next sessions</p>",
            "    <h2 id='workshops-title'>Weekend workshops for people who want ink under their fingernails.</h2>",
            "  </div>",
            "  <div class='workshop-list'>",
            "    <article>",
            "      <time datetime='2026-07-11'>July 11</time>",
            "      <h3>Intro to platen press</h3>",
            "      <p>Set type, lock a chase, print a two-color postcard, and take home fifty copies.</p>",
            "    </article>",
            "    <article>",
            "      <time datetime='2026-07-25'>July 25</time>",
            "      <h3>Wedding proof day</h3>",
            "      <p>Bring your suite draft and leave with paper, ink, and finishing decisions resolved.</p>",
            "    </article>",
            "  </div>",
            "</section>"
          ],
