          "htmlLines": [
            "<section id='invitations' class='collection section-shell' aria-labelledby='collection-title'>",
            "  <div class='section-heading split-heading'>",
            "    <div>",
            "      <p class='eyebrow'>Invitation families</p>",
            "      <h2 id='collection-title'>Three print moods, each built for customization.</h2>",
            "    </div>",
            "    <p>Every family starts with a consultation, paper pull, ink drawdown, and a physical proof before the final press run.</p>",
            "  </div>",
            "  <div class='collection-grid'>",
            "    <article class='suite-card suite-card-large'>",
            "      <p>01 / Garden formal</p>",
            "      <h3>Olive ink, soft deckle, blind pressed border.</h3>",
            "    </article>",
            "    <article class='suite-card'>",
            "      <p>02 / City evening</p>",
            "      <h3>Graphite type, foil flash, architectural spacing.</h3>",
            "    </article>",
            "    <article class='suite-card'>",
            "      <p>03 / Orchard lunch</p>",
            "      <h3>Persimmon accents, warm cotton stock, playful map insert.</h3>",
            "    </article>",
            "  </div>",
            "</section>"
          ],
          "innerBlocks": []
        },
