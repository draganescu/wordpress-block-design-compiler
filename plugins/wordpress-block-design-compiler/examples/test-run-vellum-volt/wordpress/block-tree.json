          "innerHTML": "",
          "innerContent": [
            "<section id='process' class='process section-shell' aria-labelledby='process-title'>\n  <div class='section-heading'>\n    <p class='eyebrow'>Process</p>\n    <h2 id='process-title'>A tactile production path with no mystery middle.</h2>\n  </div>\n",
            null,
            "\n</section>"
          ],
          "innerBlocks": [
            {
              "blockName": "core/list",
              "attrs": {
                "ordered": true,
                "className": "process-steps"
              },
              "htmlLines": [
                "<ol class='process-steps'>",
                "  <li><strong>Brief</strong><span>We define mood, quantities, wording, and practical deadlines.</span></li>",
                "  <li><strong>Material pull</strong><span>We compare cotton papers, envelope colors, inks, and finishes.</span></li>",
                "  <li><strong>Physical proof</strong><span>You approve a real printed sample before the full edition starts.</span></li>",
                "  <li><strong>Press run</strong><span>We print, trim, assemble, and pack the finished suite.</span></li>",
                "</ol>"
              ],
              "innerBlocks": []
            }
          ]
        },
        {
          "blockName": "core/group",
          "attrs": {
            "tagName": "section",
            "anchor": "booking",
            "className": "booking section-shell"
          },
          "innerHTML": "",
          "innerContent": [
            "<section id='booking' class='booking section-shell' aria-labelledby='booking-title'>\n  <div>\n    <p class='eyebrow'>Press consult</p>\n    <h2 id='booking-title'>Tell us what needs to feel unforgettable on paper.</h2>\n    <p>Share a date, quantity, and the kind of printed object you are imagining. We reply within two studio days.</p>\n  </div>\n",
            null,
            "\n</section>"
          ],
          "innerBlocks": [
            {
              "blockName": "wbdc/press-consult-form",
              "attrs": {
                "action": "/contact",
                "method": "post",
                "buttonText": "Send the brief",
                "fields": [
                  {
                    "label": "Name",
                    "type": "text",
                    "name": "name",
                    "placeholder": "Your name",
                    "required": true
                  },
                  {
                    "label": "Email",
                    "type": "email",
                    "name": "email",
                    "placeholder": "you@example.com",
                    "required": true
                  },
                  {
                    "label": "Project notes",
                    "type": "textarea",
                    "name": "message",
                    "placeholder": "Wedding suite, workshop date, brand cards...",
                    "required": false
                  }
                ]
              },
              "htmlLines": [
                "<section class='wp-block-wbdc-press-consult-form press-consult-form'>",
                "  <form class='press-consult-form__form booking-form' action='/contact' method='post'>",
                "    <label>",
                "      <span>Name</span>",
                "      <input name='name' type='text' placeholder='Your name' required>",
                "    </label>",
                "    <label>",
                "      <span>Email</span>",
                "      <input name='email' type='email' placeholder='you@example.com' required>",
                "    </label>",
                "    <label class='wide-field'>",
                "      <span>Project notes</span>",
                "      <textarea name='message' placeholder='Wedding suite, workshop date, brand cards...' rows='5'></textarea>",
                "    </label>",
                "    <button type='submit'>Send the brief</button>",
                "  </form>",
                "</section>"
              ],
              "innerBlocks": []
            }
          ]
        }
