          "htmlLines": [
            "<section class='hero section-shell'>",
            "  <div class='hero-copy'>",
            "    <p class='eyebrow'>Small-batch print, big-day detail</p>",
            "    <h1>Custom invitations and weekend print workshops from a working letterpress studio.</h1>",
            "    <p class='lede'>We pair hand-mixed inks, cotton papers, and antique presses to make tactile wedding suites, launch cards, and private workshop days in our bright canal-side shop.</p>",
            "    <div class='button-row'>",
            "      <a class='button button-primary' href='#booking'>Start a commission</a>",
            "      <a class='button button-secondary' href='#workshops'>View workshops</a>",
            "    </div>",
            "  </div>",
            "  <figure class='press-proof' aria-label='Layered letterpress proof sheet illustration'>",
            "    <div class='proof-card proof-card-main'>",
            "      <span class='proof-kicker'>Proof 04</span>",
            "      <strong>Fern &amp; Brass</strong>",
            "      <span>blind emboss / moss ink / deckled edge</span>",
            "    </div>",
            "    <div class='proof-card proof-card-side'>",
            "      <span class='proof-dot'></span>",
            "      <span class='proof-dot'></span>",
            "      <span class='proof-dot'></span>",
            "    </div>",
            "    <div class='registration-grid' aria-hidden='true'></div>",
            "  </figure>",
            "</section>"
