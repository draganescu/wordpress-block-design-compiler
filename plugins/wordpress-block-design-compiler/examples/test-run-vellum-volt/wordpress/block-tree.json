            "  <div class='section-heading'>",
            "    <p class='eyebrow'>What we make</p>",
            "    <h2 id='services-title'>Designed slowly, printed with pressure.</h2>",
            "  </div>",
            "  <div class='service-grid'>",
            "    <article class='service-card tall-card'>",
            "      <span class='service-number'>01</span>",
            "      <h3>Wedding suites</h3>",
            "      <p>Save-the-dates, invitations, envelopes, menus, and place cards with one consistent print system.</p>",
            "    </article>",
            "    <article class='service-card'>",
            "      <span class='service-number'>02</span>",
            "      <h3>Brand paper goods</h3>",
            "      <p>Launch notes, thank-you cards, certificates, and packaging inserts for small brands.</p>",
            "    </article>",
            "    <article class='service-card dark-card'>",
            "      <span class='service-number'>03</span>",
            "      <h3>Studio workshops</h3>",
            "      <p>Four-hour Saturday sessions for beginners, teams, and design students.</p>",
            "    </article>",
            "  </div>",
            "</section>"
          ],
          "innerBlocks": []
