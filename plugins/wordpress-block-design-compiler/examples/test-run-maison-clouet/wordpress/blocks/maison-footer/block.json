{
  "apiVersion": 3,
  "name": "wbdc/maison-footer",
  "title": "Maison Footer",
  "category": "design",
  "description": "Address, hours, Instagram, and newsletter reminder footer.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "left": { "type": "string", "default": "Maison Clouet / objects + scents / L'isle-sur-la-Sorgue" },
    "middle": { "type": "string", "default": "14 passage des Livres / Fri-Sun / @maisonclouet" },
    "backText": { "type": "string", "default": "back to the blue door" },
    "backUrl": { "type": "string", "default": "#top" },
    "style": { "type": "object", "default": {} }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "spacing": { "padding": true, "margin": true, "blockGap": true },
    "color": { "text": true, "background": true },
    "typography": { "fontSize": true, "lineHeight": true },
    "border": { "color": true, "style": true, "width": true }
  }
}
