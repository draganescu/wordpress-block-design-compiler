{
  "apiVersion": 3,
  "name": "wbdc/maison-header",
  "title": "Maison Header",
  "category": "design",
  "description": "Sticky Maison Clouet brand header with mobile-friendly navigation.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "sectionId": { "type": "string", "default": "top" },
    "brand": { "type": "string", "default": "Maison Clouet" },
    "tagline": { "type": "string", "default": "L'isle-sur-la-Sorgue" },
    "homeUrl": { "type": "string", "default": "#top" },
    "links": { "type": "array", "default": [] },
    "style": { "type": "object", "default": {} }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "spacing": { "padding": true, "margin": true, "blockGap": true },
    "color": { "text": true, "background": true },
    "typography": { "fontSize": true, "lineHeight": true },
    "border": { "color": true, "style": true, "width": true }
  }
}
