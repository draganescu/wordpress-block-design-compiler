{
  "apiVersion": 3,
  "name": "wbdc/maison-journal-row",
  "title": "Maison Journal Row",
  "category": "design",
  "description": "Magazine-column journal teaser row.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "sectionId": { "type": "string", "default": "journal" },
    "eyebrow": { "type": "string", "default": "journal / market column" },
    "heading": { "type": "string", "default": "Notes from the van before the coffee goes cold." },
    "posts": { "type": "array", "default": [] },
    "style": { "type": "object", "default": {} }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "spacing": { "padding": true, "margin": true, "blockGap": true },
    "color": { "text": true, "background": true },
    "typography": { "fontSize": true, "lineHeight": true },
    "border": { "color": true, "style": true, "width": true }
  }
}
