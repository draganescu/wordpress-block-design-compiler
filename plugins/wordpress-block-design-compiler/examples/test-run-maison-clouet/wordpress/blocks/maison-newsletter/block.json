{
  "apiVersion": 3,
  "name": "wbdc/maison-newsletter",
  "title": "Maison Newsletter",
  "category": "design",
  "description": "Semantic Friday arrivals signup form.",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "attributes": {
    "sectionId": { "type": "string", "default": "contact" },
    "eyebrow": { "type": "string", "default": "friday email / what just landed" },
    "heading": { "type": "string", "default": "A soft knock before the weekend market." },
    "body": { "type": "string", "default": "New objects, first scent pours, sourcing requests, and the occasional dinner address." },
    "buttonText": { "type": "string", "default": "join the friday list" },
    "style": { "type": "object", "default": {} }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "spacing": { "padding": true, "margin": true, "blockGap": true },
    "color": { "text": true, "background": true },
    "typography": { "fontSize": true, "lineHeight": true },
    "border": { "color": true, "style": true, "width": true }
  }
}
